# 8.1 modules/overview/WindowGrid.qml: Hỗ trợ lướt 2 ngón (touchpad / wheel) chuyển đổi workspace xoay vòng
grid_wheel_target = """        MouseArea {
            anchors.fill: parent
            acceptedButtons: Qt.NoButton
            onWheel: event => {
                if (!Config.bar.scrollActions.workspaces) return;

                if (event.angleDelta.y > 0 || event.angleDelta.x > 0) {
                    if (listView.currentIndex > 0) {
                        listView.currentIndex -= 1;
                    }
                } else if (event.angleDelta.y < 0 || event.angleDelta.x < 0) {
                    if (listView.currentIndex < listView.count - 1) {
                        listView.currentIndex += 1;
                    }
                }
            }
        }"""
grid_wheel_repl = """        property real accumulatedScrollDelta: 0
        property bool scrollCooldown: false

        Timer {
            id: scrollCooldownTimer

            interval: 220
            onTriggered: listView.scrollCooldown = false
        }
        Timer {
            id: scrollResetTimer

            interval: 350
            onTriggered: {
                listView.accumulatedScrollDelta = 0;
                listView.scrollCooldown = false;
            }
        }
        WheelHandler {
            id: overviewWheelHandler

            target: null
            orientation: Qt.Horizontal | Qt.Vertical

            onWheel: event => {
                if (root.isDragging) return;

                let dx = event.angleDelta.x !== 0 ? event.angleDelta.x : event.pixelDelta.x;
                let dy = event.angleDelta.y !== 0 ? event.angleDelta.y : event.pixelDelta.y;

                let delta = Math.abs(dx) >= Math.abs(dy) ? dx : dy;
                if (delta === 0) return;

                if (listView.scrollCooldown) {
                    scrollResetTimer.restart();
                    return;
                }

                if ((listView.accumulatedScrollDelta > 0 && delta < 0) || (listView.accumulatedScrollDelta < 0 && delta > 0)) {
                    listView.accumulatedScrollDelta = 0;
                }

                listView.accumulatedScrollDelta += delta;
                scrollResetTimer.restart();

                const threshold = 100;
                if (Math.abs(listView.accumulatedScrollDelta) >= threshold) {
                    listView.scrollCooldown = true;
                    scrollCooldownTimer.restart();
                    if (listView.accumulatedScrollDelta > 0) {
                        root.cycleWorkspace(true);
                    } else {
                        root.cycleWorkspace(false);
                    }
                    listView.accumulatedScrollDelta = 0;
                }
            }
        }"""
patch_file("modules/overview/WindowGrid.qml", grid_wheel_target, grid_wheel_repl, "WindowGrid.qml: lướt 2 ngón chuyển workspace xoay vòng")

# 8.2 modules/utilities/cards/Toggles.qml: Hỗ trợ vuốt 2 ngón tay qua trái/phải (touchpad / wheel) chuyển trang Quick Toggles
toggles_wheel_target = """    WheelHandler {
        acceptedDevices: PointerDevice.Mouse | PointerDevice.TouchPad
        onWheel: event => {
            if (root.pageCount <= 1 || root.dragging)
                return;
            const d = event.angleDelta.y !== 0 ? event.angleDelta.y : event.angleDelta.x;
            if (d < 0)
                root.requestPage(root.currentPage + 1);
            else if (d > 0)
                root.requestPage(root.currentPage - 1);
        }
    }"""
toggles_wheel_repl = """    property real swipeDeltaAcc: 0
    property bool swipeCooldown: false

    Timer {
        id: wheelCooldownTimer

        interval: 220
        repeat: false
        onTriggered: root.swipeCooldown = false
    }

    Timer {
        id: wheelResetTimer

        interval: 350
        repeat: false
        onTriggered: {
            root.swipeDeltaAcc = 0;
            root.swipeCooldown = false;
        }
    }

    WheelHandler {
        id: swipeWheelHandler

        target: null
        orientation: Qt.Horizontal | Qt.Vertical
        acceptedDevices: PointerDevice.Mouse | PointerDevice.TouchPad

        onWheel: event => {
            if (root.pageCount <= 1 || root.dragging)
                return;

            const dx = event.angleDelta.x !== 0 ? event.angleDelta.x : (event.pixelDelta.x * 6);
            const dy = event.angleDelta.y !== 0 ? event.angleDelta.y : (event.pixelDelta.y * 6);

            // Ưu tiên trục có độ dịch chuyển lớn hơn (vuốt 2 ngón ngang thì ưu tiên dx)
            const delta = Math.abs(dx) >= Math.abs(dy) ? dx : dy;
            if (delta === 0)
                return;

            if (root.swipeCooldown) {
                wheelResetTimer.restart();
                return;
            }

            // Nếu đảo chiều vuốt, reset tích luỹ delta
            if ((root.swipeDeltaAcc > 0 && delta < 0) || (root.swipeDeltaAcc < 0 && delta > 0)) {
                root.swipeDeltaAcc = 0;
            }

            root.swipeDeltaAcc += delta;
            wheelResetTimer.restart();

            const threshold = 80;
            if (Math.abs(root.swipeDeltaAcc) >= threshold) {
                root.swipeCooldown = true;
                wheelCooldownTimer.restart();

                if (root.swipeDeltaAcc < 0) {
                    root.requestPage(root.currentPage + 1);
                } else {
                    root.requestPage(root.currentPage - 1);
                }
                root.swipeDeltaAcc = 0;
            }
        }
    }"""
patch_file("modules/utilities/cards/Toggles.qml", toggles_wheel_target, toggles_wheel_repl, "Toggles.qml: vuốt 2 ngón trái/phải chuyển trang Quick Toggles")

# 9. Khôi phục cấu hình Terminal ban đầu (Fish, Starship, Fastfetch) nếu có bản lưu
import shutil

backup_base = os.path.expanduser("~/caelestia-kde/backups/20261010_211728/.config")
user_custom_dir = os.path.expanduser("~/.config/caelestia-custom/terminal")

# Nếu chưa lưu bản custom vào thư mục an toàn ~/.config/caelestia-custom/terminal thì khởi tạo từ backup
if not os.path.exists(user_custom_dir):
    os.makedirs(user_custom_dir, exist_ok=True)
    if os.path.exists(backup_base):
        for item in ["fish", "fastfetch", "starship.toml"]:
            src = os.path.join(backup_base, item)
            dst = os.path.join(user_custom_dir, item)
            if os.path.isdir(src):
                shutil.copytree(src, dst, dirs_exist_ok=True)
            elif os.path.isfile(src):
                shutil.copy2(src, dst)
        print("[✓] Đã khởi tạo bản lưu cấu hình Terminal riêng tại ~/.config/caelestia-custom/terminal")

# Khôi phục từ ~/.config/caelestia-custom/terminal vào ~/.config
if os.path.exists(user_custom_dir):
    # Fish
    custom_fish = os.path.join(user_custom_dir, "fish")
    if os.path.exists(custom_fish):
        shutil.copytree(custom_fish, os.path.expanduser("~/.config/fish"), dirs_exist_ok=True)
        # Xóa triệt để file fish_greeting.fish (chữ nghệ thuật Caelestia và fastfetch tự bật lúc mở shell)
        greeting_file = os.path.expanduser("~/.config/fish/functions/fish_greeting.fish")
        if os.path.exists(greeting_file):
            os.remove(greeting_file)
        print("[✓] Đã khôi phục cấu hình Fish riêng của bạn (tắt logo & chữ Caelestia lúc mở shell)")
    # Fastfetch
    custom_fastfetch = os.path.join(user_custom_dir, "fastfetch")
    if os.path.exists(custom_fastfetch):
        shutil.copytree(custom_fastfetch, os.path.expanduser("~/.config/fastfetch"), dirs_exist_ok=True)
        print("[✓] Đã khôi phục cấu hình Fastfetch riêng của bạn")
    # Starship
    custom_starship = os.path.join(user_custom_dir, "starship.toml")
    if os.path.exists(custom_starship):
        shutil.copy2(custom_starship, os.path.expanduser("~/.config/starship.toml"))
        print("[✓] Đã khôi phục cấu hình Starship riêng của bạn")

# 10. Đảm bảo cấu hình Krohnkite Quarter Layout (chia 4 ô đều nhau)
kwinrc_path = os.path.expanduser("~/.config/kwinrc")
if os.path.exists(kwinrc_path):
    try:
        subprocess.run(["kwriteconfig6", "--file", kwinrc_path, "--group", "Script-krohnkite", "--key", "quarterLayoutOrder", "1"], check=False)
        subprocess.run(["kwriteconfig6", "--file", kwinrc_path, "--group", "Script-krohnkite", "--key", "binaryTreeLayoutOrder", "2"], check=False)
        subprocess.run(["kwriteconfig6", "--file", kwinrc_path, "--group", "Script-krohnkite", "--key", "floatingLayoutOrder", "3"], check=False)
        subprocess.run(["kwriteconfig6", "--file", kwinrc_path, "--group", "Script-krohnkite", "--key", "monocleLayoutOrder", "0"], check=False)
        subprocess.run(["kwriteconfig6", "--file", kwinrc_path, "--group", "Script-krohnkite", "--key", "tileLayoutOrder", "0"], check=False)
        # Nạp lại script KWin nếu đang chạy
        subprocess.run(["qdbus6", "org.kde.KWin", "/KWin", "reconfigure"], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        print("[✓] Đã đảm bảo Krohnkite chạy layout Quarter (chia 4 ô đều nhau)")
    except Exception as e:
        print(f"[!] Không thể cấu hình Krohnkite: {e}")
print("=== Hoàn tất áp dụng tùy chỉnh ===")