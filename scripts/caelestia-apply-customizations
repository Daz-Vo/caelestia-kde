panels_replacement = """        readonly property real _pushOffset: shouldPush ? (popoutsWrapper.implicitHeight + Tokens.spacing.extraLarge) : 0
        readonly property real _utilitiesPushOffset: (utilities.visible && utilities.offsetScale < 1 && _notifV === "top" && _notifH === "right" && bar.position === "bottom")
            ? ((utilities.implicitHeight - root.borderThickness) * (1 - utilities.offsetScale))
            : 0"""
patch_file("modules/drawers/Panels.qml", panels_target, panels_replacement, "Panels.qml: định nghĩa _utilitiesPushOffset")

