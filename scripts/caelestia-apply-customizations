# 4. shell.json: Đảm bảo thông báo ở góc trên bên phải
shell_json_path = os.path.join(CONFIG_DIR, "shell.json")
if os.path.exists(shell_json_path):
    with open(shell_json_path, "r", encoding="utf-8") as f:
        data = json.load(f)
    if "notifs" not in data:
        data["notifs"] = {}
    if data["notifs"].get("position") != "top-right":
        data["notifs"]["position"] = "top-right"
        with open(shell_json_path, "w", encoding="utf-8") as f:
            json.dump(data, f, indent=4)
        print("[✓] Đã lưu notifs.position = top-right trong shell.json")
    else:
        print("[✓] shell.json đã có notifs.position = top-right")

# 5. keybinds.json & kglobalshortcutsrc: Đảm bảo Win + Tab mở Overview và Win + Del mở Menu Nguồn
keybinds_path = os.path.join(CONFIG_DIR, "keybinds.json")
if os.path.exists(keybinds_path):
    with open(keybinds_path, "r", encoding="utf-8") as f:
        kdata = json.load(f)
    changed = False
    if kdata.get("overview") != "Meta+Tab":
        kdata["overview"] = "Meta+Tab"
        changed = True
    if kdata.get("session") != "Meta+Delete":
        kdata["session"] = "Meta+Delete"
        changed = True
    if changed:
        with open(keybinds_path, "w", encoding="utf-8") as f:
            json.dump(kdata, f, indent=2)
        print("[✓] Đã cập nhật overview (Meta+Tab) và session (Meta+Delete) trong keybinds.json")
    else:
        print("[✓] keybinds.json đã đồng bộ chuẩn (Meta+Tab và Meta+Delete)")

# Đồng bộ trực tiếp vào kglobalshortcutsrc
kglobal_path = os.path.expanduser("~/.config/kglobalshortcutsrc")
if os.path.exists(kglobal_path):
    try:
        subprocess.run(["kwriteconfig6", "--file", kglobal_path, "--group", "caelestia-shell", "--key", "caelestia-shortcut-session", "Meta+Del,none,Toggle session menu"], check=False)
        subprocess.run(["gdbus", "call", "--session", "--dest", "org.kde.kglobalaccel", "--object-path", "/kglobalaccel", "--method", "org.kde.KGlobalAccel.setShortcutKeys", "['caelestia-shell', 'caelestia-shortcut-session', '', '']", "[([285212679, 0, 0, 0],)]", "4"], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        print("[✓] Đã kích hoạt phím tắt Super + Delete cho Menu Nguồn trong hệ thống KDE")
    except Exception as e:
        print(f"[!] Không thể cập nhật kglobalshortcutsrc: {e}")

