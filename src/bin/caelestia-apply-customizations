#!/usr/bin/env python3
import os, sys, json

QS_DIR = os.path.expanduser('~/.config/quickshell/caelestia')
CONFIG_DIR = os.path.expanduser('~/.config/caelestia')

def patch_file(rel_path, target, replacement, desc):
    full_path = os.path.join(QS_DIR, rel_path)
    if not os.path.exists(full_path):
        print(f"[-] Bỏ qua {desc}: không tìm thấy {full_path}")
        return False
    with open(full_path, "r", encoding="utf-8") as f:
        content = f.read()
    if replacement in content:
        print(f"[✓] {desc}: đã được áp dụng.")
        return True
    if target in content:
        content = content.replace(target, replacement, 1)
        with open(full_path, "w", encoding="utf-8") as f:
            f.write(content)
        print(f"[✓] Áp dụng thành công: {desc}")
        return True
    else:
        print(f"[!] Không tìm thấy đoạn code gốc của: {desc}")
        return False

print("=== Đang áp dụng các tùy chỉnh Caelestia ===")

# 1. Panels.qml: Tránh nhảy thông báo và dính liền khối với Utilities
panels_target = "        readonly property real _pushOffset: shouldPush ? (popoutsWrapper.implicitHeight + Tokens.spacing.extraLarge) : 0"
panels_replacement = """        readonly property real _pushOffset: shouldPush ? (popoutsWrapper.implicitHeight + Tokens.spacing.extraLarge) : 0
        readonly property real _utilitiesPushOffset: (utilities.visible && utilities.offsetScale < 1 && _notifV === "top" && _notifH === "right" && bar.position === "bottom")
            ? ((utilities.implicitHeight - root.borderThickness) * (1 - utilities.offsetScale))
            : 0"""
patch_file("modules/drawers/Panels.qml", panels_target, panels_replacement, "Panels.qml: định nghĩa _utilitiesPushOffset")

panels_y_target = """        y: {
            if (_notifV === "top") return _pushOffset;
            return Math.max(0, parent.height - implicitHeight - _pushOffset);
        }"""
panels_y_replacement = """        y: {
            if (_notifV === "top") return _pushOffset + _utilitiesPushOffset;
            return Math.max(0, parent.height - implicitHeight - _pushOffset);
        }"""
patch_file("modules/drawers/Panels.qml", panels_y_target, panels_y_replacement, "Panels.qml: vị trí notifications.y")

push_cond_target = "property bool shouldPush: root.popoutIntersectsRight && !popoutsWrapper.content.isDockPopout && !sidebar.visible"
push_cond_replacement = "property bool shouldPush: root.popoutIntersectsRight && !popoutsWrapper.content.isDockPopout && !sidebar.visible && (bar.position === _notifV)"
patch_file("modules/drawers/Panels.qml", push_cond_target, push_cond_replacement, "Panels.qml: điều kiện shouldPush theo trục dọc")

# 2. Kwin.qml: Chặn toast Num Lock / Caps Lock khi khởi động
kwin_target = """    onCapsLockChanged: {
        if (!GlobalConfig.utilities.toasts.capsLockChanged)
            return;
        Toaster.toast(
            capsLock ? qsTr("Caps lock enabled") : qsTr("Caps lock disabled"),
            capsLock ? qsTr("Caps lock is currently enabled") : qsTr("Caps lock is currently disabled"),
            capsLock ? "keyboard_capslock_badge" : "keyboard_capslock"
        );
    }

    onNumLockChanged: {
        if (!GlobalConfig.utilities.toasts.numLockChanged)
            return;
        Toaster.toast(
            numLock ? qsTr("Num lock enabled") : qsTr("Num lock disabled"),
            numLock ? qsTr("Num lock is currently enabled") : qsTr("Num lock is currently disabled"),
            numLock ? "looks_one" : "timer_1"
        );
    }"""
kwin_replacement = """    property bool initialized: false
    Timer {
        interval: 1500
        running: true
        onTriggered: root.initialized = true
    }

    onCapsLockChanged: {
        if (!root.initialized || !GlobalConfig.utilities.toasts.capsLockChanged)
            return;
        Toaster.toast(
            capsLock ? qsTr("Caps lock enabled") : qsTr("Caps lock disabled"),
            capsLock ? qsTr("Caps lock is currently enabled") : qsTr("Caps lock is currently disabled"),
            capsLock ? "keyboard_capslock_badge" : "keyboard_capslock"
        );
    }

    onNumLockChanged: {
        if (!root.initialized || !GlobalConfig.utilities.toasts.numLockChanged)
            return;
        Toaster.toast(
            numLock ? qsTr("Num lock enabled") : qsTr("Num lock disabled"),
            numLock ? qsTr("Num lock is currently enabled") : qsTr("Num lock is currently disabled"),
            numLock ? "looks_one" : "timer_1"
        );
    }"""
patch_file("services/Kwin.qml", kwin_target, kwin_replacement, "Kwin.qml: Startup guard cho Num Lock / Caps Lock")

# 3. osd/Wrapper.qml: Chặn OSD âm thanh & độ sáng khi khởi động
osd_target = """    function show(): void {
        visibilities.osd = true;
        timer.restart();
    }"""
osd_replacement = """    property bool initialized: false

    Timer {
        interval: 1500
        running: true
        onTriggered: root.initialized = true
    }

    function show(): void {
        if (!root.initialized)
            return;
        visibilities.osd = true;
        timer.restart();
    }"""
patch_file("modules/osd/Wrapper.qml", osd_target, osd_replacement, "osd/Wrapper.qml: Startup guard cho OSD âm lượng / độ sáng")

# 4. shell.json: Đảm bảo thông báo ở góc trên bên phải
shell_json_path = os.path.join(CONFIG_DIR, "shell.json")
if os.path.exists(shell_json_path):
    with open(shell_json_path, "r", encoding="utf-8") as f:
        data = json.load(f)
    if "notifs" not in data:
        data["notifs"] = {}
    if data["notifs"].get("position") != "top-right":
        data["notifs"]["position"] = "top-right"
        with open(shell_json_path, "w", encoding="utf-8") as f:
            json.dump(data, f, indent=4)
        print("[✓] Đã lưu notifs.position = top-right trong shell.json")
    else:
        print("[✓] shell.json đã có notifs.position = top-right")

# 5. keybinds.json: Đảm bảo Win + Tab mở Caelestia Overview
keybinds_path = os.path.join(CONFIG_DIR, "keybinds.json")
if os.path.exists(keybinds_path):
    with open(keybinds_path, "r", encoding="utf-8") as f:
        kdata = json.load(f)
    if kdata.get("overview") != "Meta+Tab":
        kdata["overview"] = "Meta+Tab"
        with open(keybinds_path, "w", encoding="utf-8") as f:
            json.dump(kdata, f, indent=2)
        print("[✓] Đã lưu overview = Meta+Tab trong keybinds.json")
    else:
        print("[✓] keybinds.json đã có overview = Meta+Tab")

# 6. modules/overview/components/workspaces/Workspace.qml: Chuyển workspace không thoát, click workspace hiện tại để thoát

ws_click_target = """        onClicked: {
            if (active) {
                reselected();
                let p = parent;
                while (p) {
                    if (p.requestClose) {
                        p.requestClose();
                        break;
                    }
                    p = p.parent;
                }
            } else {
                const wId = Kwin.workspaces[root.ws - 1]?.id || root.ws.toString();
                Kwin.switchToWorkspace(wId, root.screenName);
                selected();
            }
        }"""
ws_click_repl = """        onClicked: {
            if (active) {
                reselected();
            } else {
                const wId = Kwin.workspaces[root.ws - 1]?.id || root.ws.toString();
                Kwin.switchToWorkspace(wId, root.screenName);
                selected();
            }
        }"""
patch_file("modules/overview/components/workspaces/Workspace.qml", ws_click_target, ws_click_repl, "Workspace.qml: click workspace hiện tại để thoát, workspace khác để chuyển")

ws_win_target = """                        if (root.active) {
                            if (modelData.address) {
                                Kwin.focusWindow(modelData.address);
                                
                                let p = parent;
                                while (p) {
                                    if (p.requestClose) {
                                        p.requestClose();
                                        break;
                                    }
                                    p = p.parent;
                                }
                            }
                        } else {
                            root.selected();
                        }"""
ws_win_repl = """                        if (root.active) {
                            if (modelData.address) {
                                Kwin.focusWindow(modelData.address);
                            }
                            root.reselected();
                        } else {
                            const wId = Kwin.workspaces[root.ws - 1]?.id || root.ws.toString();
                            Kwin.switchToWorkspace(wId, root.screenName);
                            root.selected();
                        }"""
patch_file("modules/overview/components/workspaces/Workspace.qml", ws_win_target, ws_win_repl, "Workspace.qml: click icon cửa sổ để chuyển / focus và thoát")

# 7. modules/overview/WindowGrid.qml: Chuyển workspace ngay lập tức khi click WorkspaceIndicator
grid_target1 = """            onWorkspaceSelected: index => {
                root.ignoreNextSwitch = false;
                listView.currentIndex = index;
            }"""
grid_repl1 = """            onWorkspaceSelected: index => {
                root.ignoreNextSwitch = false;
                listView.currentIndex = index;
                if (Kwin.workspaces && index < Kwin.workspaces.length) {
                    const targetId = Kwin.workspaces[index].id || Kwin.workspaces[index].index;
                    Kwin.switchToWorkspace(targetId, root.screen.name);
                }
            }"""
patch_file("modules/overview/WindowGrid.qml", grid_target1, grid_repl1, "WindowGrid.qml: chuyển workspace tức thì khi chọn từ indicator")

grid_target2 = """        for (let i = 0; i < Kwin.workspaces.length; ++i) {
            const wId = Kwin.workspaces[i].index;
            if (wId === activeWsId) {
                if (listView.currentIndex !== i) {
                    listView.currentIndex = i;
                }
                if (!root._initialized || root.opacity <= 0.01)
                    listView.positionViewAtIndex(i, ListView.SnapPosition);
                break;
            }
        }
        root.ignoreNextSwitch = false;"""
grid_repl2 = """        for (let i = 0; i < Kwin.workspaces.length; ++i) {
            const wId = Kwin.workspaces[i].index;
            if (wId === activeWsId) {
                if (listView.currentIndex !== i) {
                    root.ignoreNextSwitch = true;
                    listView.currentIndex = i;
                    root.ignoreNextSwitch = false;
                }
                if (!root._initialized || root.opacity <= 0.01)
                    listView.positionViewAtIndex(i, ListView.SnapPosition);
                break;
            }
        }"""
patch_file("modules/overview/WindowGrid.qml", grid_target2, grid_repl2, "WindowGrid.qml: tránh kích hoạt nhầm switchTimer trong syncPage")

# 8. modules/overview/WindowGrid.qml: Nút mũi tên 2 bên màn hình chuyển workspace xoay vòng tròn
grid_cycle_func_target = """    function activateSelected(): void {"""
grid_cycle_func_repl = """    function cycleWorkspace(backwards: bool): void {
        const total = listView.count;
        if (total <= 1) return;
        let nextIndex;
        if (backwards) {
            nextIndex = listView.currentIndex <= 0 ? total - 1 : listView.currentIndex - 1;
        } else {
            nextIndex = listView.currentIndex >= total - 1 ? 0 : listView.currentIndex + 1;
        }
        root.ignoreNextSwitch = false;
        listView.currentIndex = nextIndex;
        if (Kwin.workspaces && nextIndex < Kwin.workspaces.length) {
            const targetId = Kwin.workspaces[nextIndex].id || Kwin.workspaces[nextIndex].index;
            Kwin.switchToWorkspace(targetId, root.screen.name);
        }
    }
    function activateSelected(): void {"""
patch_file("modules/overview/WindowGrid.qml", grid_cycle_func_target, grid_cycle_func_repl, "WindowGrid.qml: hàm cycleWorkspace xoay vòng")

grid_chev_target = """        visible: listView.currentIndex > 0

        HoverHandler { id: hoverPrev }
        StateLayer {
            anchors.fill: parent
            radius: parent.radius
            onClicked: listView.currentIndex -= 1
        }
        MaterialIcon {
            id: prevIcon

            anchors.centerIn: parent
            text: "chevron_left"
            color: Colours.palette.m3onSurface
            fontStyle.pointSize: Tokens.font.body.large.pointSize
        }
    }
    StyledRect {
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        anchors.rightMargin: Tokens.padding.large
        implicitWidth: nextIcon.implicitWidth + Tokens.padding.large * 2
        implicitHeight: nextIcon.implicitHeight + Tokens.padding.large * 2
        radius: height / 2
        color: Colours.tPalette.m3surfaceContainerHigh
        opacity: hoverNext.hovered ? 1 : 0.6
        visible: listView.currentIndex < listView.count - 1

        HoverHandler { id: hoverNext }
        StateLayer {
            anchors.fill: parent
            radius: parent.radius
            onClicked: listView.currentIndex += 1
        }"""
grid_chev_repl = """        visible: listView.count > 1

        HoverHandler { id: hoverPrev }
        StateLayer {
            anchors.fill: parent
            radius: parent.radius
            onClicked: root.cycleWorkspace(true)
        }
        MaterialIcon {
            id: prevIcon

            anchors.centerIn: parent
            text: "chevron_left"
            color: Colours.palette.m3onSurface
            fontStyle.pointSize: Tokens.font.body.large.pointSize
        }
    }
    StyledRect {
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        anchors.rightMargin: Tokens.padding.large
        implicitWidth: nextIcon.implicitWidth + Tokens.padding.large * 2
        implicitHeight: nextIcon.implicitHeight + Tokens.padding.large * 2
        radius: height / 2
        color: Colours.tPalette.m3surfaceContainerHigh
        opacity: hoverNext.hovered ? 1 : 0.6
        visible: listView.count > 1

        HoverHandler { id: hoverNext }
        StateLayer {
            anchors.fill: parent
            radius: parent.radius
            onClicked: root.cycleWorkspace(false)
        }"""
patch_file("modules/overview/WindowGrid.qml", grid_chev_target, grid_chev_repl, "WindowGrid.qml: nút mũi tên 2 bên xoay vòng workspace")

# 9. Khôi phục cấu hình Terminal ban đầu (Fish, Starship, Fastfetch) nếu có bản lưu
import shutil

backup_base = os.path.expanduser("~/caelestia-kde/backups/20261010_211728/.config")
user_custom_dir = os.path.expanduser("~/.config/caelestia-custom/terminal")

# Nếu chưa lưu bản custom vào thư mục an toàn ~/.config/caelestia-custom/terminal thì khởi tạo từ backup
if not os.path.exists(user_custom_dir):
    os.makedirs(user_custom_dir, exist_ok=True)
    if os.path.exists(backup_base):
        for item in ["fish", "fastfetch", "starship.toml"]:
            src = os.path.join(backup_base, item)
            dst = os.path.join(user_custom_dir, item)
            if os.path.isdir(src):
                shutil.copytree(src, dst, dirs_exist_ok=True)
            elif os.path.isfile(src):
                shutil.copy2(src, dst)
        print("[✓] Đã khởi tạo bản lưu cấu hình Terminal riêng tại ~/.config/caelestia-custom/terminal")

# Khôi phục từ ~/.config/caelestia-custom/terminal vào ~/.config
if os.path.exists(user_custom_dir):
    # Fish
    custom_fish = os.path.join(user_custom_dir, "fish")
    if os.path.exists(custom_fish):
        shutil.copytree(custom_fish, os.path.expanduser("~/.config/fish"), dirs_exist_ok=True)
        # Xóa triệt để file fish_greeting.fish (chữ nghệ thuật Caelestia và fastfetch tự bật lúc mở shell)
        greeting_file = os.path.expanduser("~/.config/fish/functions/fish_greeting.fish")
        if os.path.exists(greeting_file):
            os.remove(greeting_file)
        print("[✓] Đã khôi phục cấu hình Fish riêng của bạn (tắt logo & chữ Caelestia lúc mở shell)")
    # Fastfetch
    custom_fastfetch = os.path.join(user_custom_dir, "fastfetch")
    if os.path.exists(custom_fastfetch):
        shutil.copytree(custom_fastfetch, os.path.expanduser("~/.config/fastfetch"), dirs_exist_ok=True)
        print("[✓] Đã khôi phục cấu hình Fastfetch riêng của bạn")
    # Starship
    custom_starship = os.path.join(user_custom_dir, "starship.toml")
    if os.path.exists(custom_starship):
        shutil.copy2(custom_starship, os.path.expanduser("~/.config/starship.toml"))
        print("[✓] Đã khôi phục cấu hình Starship riêng của bạn")

print("=== Hoàn tất áp dụng tùy chỉnh ===")